# ── Lovable Cloud / Supabase (already provisioned — copy real values from .env) ──
SUPABASE_PROJECT_ID=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_URL=""
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# ── Lead source (pick ONE — checked in this priority order in src/lib/scraper.server.ts) ──
# 1) Your own FastAPI scraper. Set this and searches stop using demo data immediately.
LEADS_API_URL=""
# Optional bearer/X-API-Key sent to LEADS_API_URL if your FastAPI service requires auth.
LEADS_API_KEY=""

# 2) OR the built-in Google Maps connector (used only if LEADS_API_URL is unset).
#    Requires connecting "Google Maps Platform" in Lovable Cloud, which provides these:
LOVABLE_API_KEY=""
GOOGLE_MAPS_API_KEY=""

# If neither is set, /find-leads silently falls back to demo results (safe default,
# but not "real" data — this is what "demo mode" refers to in the app).

# ── Razorpay (live payments — currently unset, so checkout button will error) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
