# ── Server ──
PORT=4000
NODE_ENV=development
# Frontend origin(s), comma-separated. Needed for CORS + OAuth/payment redirects.
FRONTEND_URL=http://localhost:5173
# Public URL of THIS backend (used to build the Google OAuth callback URL).
BACKEND_URL=http://localhost:4000

# ── MongoDB ──
# Use MongoDB Atlas (free tier is fine) or any self-hosted MongoDB instance.
MONGODB_URI=mongodb://localhost:27017/leadfinder

# ── Auth (JWT cookie session) ──
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# ── Google OAuth (console.cloud.google.com -> APIs & Services -> Credentials) ──
# Authorized redirect URI to register there: {BACKEND_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Lead source (checked in this order — see src/services/scraper.service.ts) ──
LEADS_API_URL=
LEADS_API_KEY=
GOOGLE_MAPS_API_KEY=

# ── Razorpay ──
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── AI features (Phase 2: lead analysis + outreach drafts) ──
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5
